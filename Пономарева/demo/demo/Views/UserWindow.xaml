<Window x:Class="demo.Views.UserWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Рабочий стол пользователя" Height="300" Width="400" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="TxtWelcome" FontSize="18" TextWrapping="Wrap" TextAlignment="Center"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Выйти" Width="100" Height="30" HorizontalAlignment="Center" Click="BtnExit_Click"/>
    </Grid>
</Window>