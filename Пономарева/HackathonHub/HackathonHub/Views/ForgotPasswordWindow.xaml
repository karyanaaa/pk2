<Window x:Class="HackathonHub.Client.Views.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HackathonHub — Сброс пароля" Height="750" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#e8f4f8"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderSoft" Color="#b8d8e4"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#4a90a4"/>
        <SolidColorBrush x:Key="AccentLavender" Color="#a8c8e8"/>
        <SolidColorBrush x:Key="Danger" Color="#e07a7a"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6bb6c9" Offset="0"/>
            <GradientStop Color="#a8c8e8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#f5fbfd"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8ab4c8" BlurRadius="18" ShadowDepth="3" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5f7f8f"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5f7f8f"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#4a90a4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6bb6c9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10"
                                Background="#d4e9f0"
                                BorderBrush="#b8d8e4"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#a8c8e8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Style="{StaticResource Card}"
                Width="540" Padding="50,45"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Width="90" Height="90" CornerRadius="45"
                        Background="{StaticResource AccentGradient}"
                        HorizontalAlignment="Center" Margin="0,0,0,25">
                    <TextBlock Text="🔑" FontSize="45"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Сброс пароля" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>

                <TextBlock Text="Введите email, привязанный к аккаунту. Мы сгенерируем токен для сброса пароля."
                           Style="{StaticResource SubtitleText}"
                           TextWrapping="Wrap" TextAlignment="Center"
                           Margin="0,0,0,30"/>

                <TextBlock Text="EMAIL" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource SoftTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,20"/>

                <Border CornerRadius="10" Padding="14,12" Margin="0,0,0,20"
                        Visibility="{Binding HasStatusVisibility}"
                        Background="{Binding StatusBackground}">
                    <TextBox Text="{Binding StatusMessage, Mode=OneWay}"
                             FontSize="13"
                             TextWrapping="Wrap"
                             Foreground="{Binding StatusColor}"
                             Background="Transparent"
                             BorderThickness="0"
                             IsReadOnly="True"
                             Cursor="IBeam"
                             Padding="0"/>
                </Border>

                <Button Content="ОТПРАВИТЬ ИНСТРУКЦИЮ"
                        Command="{Binding SendResetCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="50" FontSize="15" Margin="0,0,0,15"/>

                <Button Content="ВВЕСТИ ТОКЕН ВРУЧНУЮ"
                        Click="OpenResetPassword_Click"
                        Style="{StaticResource SecondaryButton}"
                        Height="45" FontSize="14" Margin="0,0,0,15"/>

                <Button Content="← Вернуться ко входу"
                        Command="{Binding BackCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="45" FontSize="14"/>
            </StackPanel>
        </Border>

        <Border Background="#cc000000"
                Visibility="{Binding IsLoadingVisibility}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Отправка..." Foreground="White" FontSize="20"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>