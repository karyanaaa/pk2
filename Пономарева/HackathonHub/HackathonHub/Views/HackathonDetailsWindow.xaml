<Window x:Class="HackathonHub.Client.Views.HackathonDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали хакатона" Height="800" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="#f7fafc">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="24" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="{StaticResource SkyGrad}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="#eef4f8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dde9f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Table" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#fafcfd"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#eef4f8"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="42"/>
        </Style>
    </Window.Resources>

    <ScrollViewer>
        <Border Style="{StaticResource Tile}" Margin="20" Padding="30">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="28" FontWeight="Bold"
                           Foreground="#1a2b38"/>
                <TextBlock x:Name="StatusText"
                           FontSize="13" Foreground="#7d8f9c"
                           Margin="0,4,0,20"/>

                <TextBlock Text="ОПИСАНИЕ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <TextBlock x:Name="DescText"
                           Foreground="#1a2b38" TextWrapping="Wrap"
                           FontSize="14" Margin="0,0,0,20"/>

                <TextBlock Text="ЗАДАНИЕ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <Border Background="#fff8e1" CornerRadius="14" Padding="18"
                        Margin="0,0,0,20">
                    <TextBlock x:Name="TaskText"
                               Foreground="#1a2b38" TextWrapping="Wrap"
                               FontSize="14"/>
                </Border>

                <Border Background="#e8f4f8" CornerRadius="14"
                        Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="СТАРТ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c"/>
                            <TextBlock x:Name="StartText" Foreground="#1a2b38"
                                       FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ОКОНЧАНИЕ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c"/>
                            <TextBlock x:Name="EndText" Foreground="#1a2b38"
                                       FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="ДЕДЛАЙН" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c"/>
                            <TextBlock x:Name="DeadlineText" Foreground="#1a2b38"
                                       FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="КОМАНДЫ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <DataGrid x:Name="TeamsGrid"
                          Style="{StaticResource Table}"
                          Height="200" Margin="0,0,0,20">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="НАЗВАНИЕ" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="КАПИТАН" Binding="{Binding CaptainName}" Width="200"/>
                        <DataGridTextColumn Header="УЧАСТНИКОВ" Binding="{Binding Members.Count}" Width="120"/>
                        <DataGridTemplateColumn Header="ПРОЕКТ" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SubmissionIcon}"
                                                   FontSize="14" VerticalAlignment="Center"
                                                   Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding SubmissionText}"
                                                   FontSize="12"
                                                   Foreground="#1a2b38"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Margin="0,0,0,15">
                    <Button x:Name="CreateTeamBtn"
                            Content="СОЗДАТЬ КОМАНДУ"
                            Click="CreateTeam_Click"
                            Style="{StaticResource Pill}"
                            Height="48" FontSize="13" Margin="0,0,10,10"
                            MinWidth="200"/>

                    <Button x:Name="JoinTeamBtn"
                            Content="ОТПРАВИТЬ ЗАЯВКУ"
                            Click="JoinTeam_Click"
                            Style="{StaticResource SoftPill}"
                            Height="48" FontSize="13" Margin="0,0,10,10"
                            MinWidth="200"/>

                    <Button x:Name="UploadProjectBtn"
                            Content="ЗАГРУЗИТЬ ПРОЕКТ"
                            Click="UploadProject_Click"
                            Style="{StaticResource Pill}"
                            Height="48" FontSize="13" Margin="0,0,10,10"
                            MinWidth="200"/>
                </WrapPanel>

                <WrapPanel Margin="0,0,0,15">
                    <Button x:Name="AddCriterionBtn"
                            Content="➕ ДОБАВИТЬ КРИТЕРИЙ"
                            Click="AddCriterion_Click"
                            Style="{StaticResource SoftPill}"
                            Height="48" FontSize="13" Margin="0,0,10,10"
                            MinWidth="220"/>

                    <Button x:Name="ManageCriteriaBtn"
                            Content="📋 УПРАВЛЕНИЕ КРИТЕРИЯМИ"
                            Click="ManageCriteria_Click"
                            Style="{StaticResource SoftPill}"
                            Height="48" FontSize="13" Margin="0,0,10,10"
                            MinWidth="220"/>
                    <Button x:Name="ManageRegistrationsBtn"
        Content="📨 ЗАЯВКИ НА ХАКАТОН"
        Click="ManageRegistrations_Click"
        Style="{StaticResource SoftPill}"
        Height="48" FontSize="13" Margin="0,0,10,10"
        MinWidth="220"/>
                    <Button x:Name="DeleteHackathonBtn"
                            Content="🗑 УДАЛИТЬ ХАКАТОН"
                            Click="DeleteHackathon_Click"
                            Style="{StaticResource SoftPill}"
                            Background="#f8d7d7"
                            Height="48" FontSize="13" Margin="0,0,10,10"
                            MinWidth="220"/>
                </WrapPanel>

                <Button x:Name="ApplyBtn"
                        Content="ПОДАТЬ ЗАЯВКУ"
                        Click="Apply_Click"
                        Style="{StaticResource Pill}"
                        Height="50" FontSize="14"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>