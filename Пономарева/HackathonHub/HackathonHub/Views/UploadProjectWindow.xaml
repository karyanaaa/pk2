<Window x:Class="HackathonHub.Client.Views.UploadProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузить проект" Height="700" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#f7fafc"
        ResizeMode="CanResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="24" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="{StaticResource SkyGrad}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="#eef4f8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dde9f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Tile}" Margin="20" Padding="30">
            <StackPanel>
                <TextBlock Text="Загрузка проекта" FontSize="26" FontWeight="Bold"
                           Foreground="#1a2b38" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                <TextBlock Text="НАЗВАНИЕ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,4"/>
                <TextBox x:Name="TitleBox" Padding="12,10" FontSize="14"
                         Background="White" BorderBrush="#dde9f0" BorderThickness="1"
                         Margin="0,0,0,15"/>

                <TextBlock Text="ОПИСАНИЕ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,4"/>
                <TextBox x:Name="DescBox" AcceptsReturn="True" Height="80"
                         TextWrapping="Wrap" Padding="12,10" FontSize="13"
                         Background="White" BorderBrush="#dde9f0" BorderThickness="1"
                         Margin="0,0,0,15"/>

                <TextBlock Text="ССЫЛКА НА РЕПОЗИТОРИЙ (необязательно)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,4"/>
                <TextBox x:Name="RepoBox" Padding="12,10" FontSize="13"
                         Background="White" BorderBrush="#dde9f0" BorderThickness="1"
                         Margin="0,0,0,15"/>

                <TextBlock Text="АРХИВ С ПРОЕКТОМ (файл .zip / .rar)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,4"/>

                <Border Background="#f7fafc" CornerRadius="12"
                        Padding="14" BorderBrush="#dde9f0" BorderThickness="1"
                        Margin="0,0,0,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="FilePathText"
                                   Text="Файл не выбран"
                                   Foreground="#7d8f9c"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Content="📁 ВЫБРАТЬ"
                                Click="Browse_Click"
                                Style="{StaticResource SoftPill}"
                                Padding="16,8"/>
                    </Grid>
                </Border>

                <TextBlock Text="ПРЕЗЕНТАЦИЯ (файл .pdf / .pptx)"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,4"/>

                <Border Background="#f7fafc" CornerRadius="12"
                        Padding="14" BorderBrush="#dde9f0" BorderThickness="1"
                        Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   x:Name="PresentationPathText"
                                   Text="Файл не выбран"
                                   Foreground="#7d8f9c"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1"
                                Content="📁 ВЫБРАТЬ"
                                Click="BrowsePresentation_Click"
                                Style="{StaticResource SoftPill}"
                                Padding="16,8"/>
                    </Grid>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="ОТМЕНА"
                            Click="Cancel_Click"
                            Style="{StaticResource SoftPill}"
                            Width="120" Margin="0,0,10,0"/>
                    <Button Content="✓ ЗАГРУЗИТЬ"
                            Click="Upload_Click"
                            Style="{StaticResource Pill}"
                            Width="140"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>