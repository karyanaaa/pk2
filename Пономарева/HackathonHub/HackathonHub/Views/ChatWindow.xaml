<Window x:Class="HackathonHub.Client.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат хакатона" Height="650" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#f7fafc"
        ResizeMode="CanResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="18" ShadowDepth="3" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="{StaticResource SkyGrad}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderText"
                   Grid.Row="0"
                   FontSize="20" FontWeight="Bold"
                   Foreground="#1a2b38"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource Tile}" Padding="12">
            <ScrollViewer x:Name="MessagesScroll"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="MessagesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#f7fafc" CornerRadius="12"
                                    Padding="12,8" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding UserName}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="#5eb3d6"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat=' · dd.MM HH:mm'}"
                                                   FontSize="10" Foreground="#7d8f9c"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}"
                                               FontSize="13" Foreground="#1a2b38"
                                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="MessageBox"
                     Grid.Column="0"
                     Padding="12,10" FontSize="14"
                     Background="White" BorderBrush="#dde9f0"
                     BorderThickness="1"
                     KeyDown="MessageBox_KeyDown"
                     VerticalContentAlignment="Center"/>

            <Button Grid.Column="1"
                    Content="ОТПРАВИТЬ"
                    Click="Send_Click"
                    Style="{StaticResource Pill}"
                    Margin="10,0,0,0"/>
        </Grid>
    </Grid>
</Window>