<Window x:Class="HackathonHub.Client.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HackathonHub — Регистрация" Height="820" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#e8f4f8"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <SolidColorBrush x:Key="BorderSoft" Color="#b8d8e4"/>
        <SolidColorBrush x:Key="TextDark" Color="#1e3a4c"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5f7f8f"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#4a90a4"/>
        <SolidColorBrush x:Key="Danger" Color="#e07a7a"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#f5fbfd"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8ab4c8" BlurRadius="18" ShadowDepth="3" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5f7f8f"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5f7f8f"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#4a90a4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6bb6c9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль Toggle-переключателя -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track"
                                    Width="46" Height="24" CornerRadius="12"
                                    Background="#b8d8e4">
                                <Ellipse x:Name="Thumb"
                                         Width="18" Height="18"
                                         Fill="White"
                                         HorizontalAlignment="Left"
                                         Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0"
                                              VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#4a90a4"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}"
                Width="520" Padding="50,45"
                HorizontalAlignment="Center" Margin="0,40">
            <StackPanel>
                <TextBlock Text="Создать аккаунт" Style="{StaticResource TitleText}"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="Присоединяйтесь к HackathonHub"
                           Style="{StaticResource SubtitleText}"
                           HorizontalAlignment="Center" Margin="0,0,0,35"/>

                <TextBlock Text="ПОЛНОЕ ИМЯ" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource SoftTextBox}"
                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,18"/>

                <TextBlock Text="EMAIL" Style="{StaticResource LabelText}"/>
                <TextBox Style="{StaticResource SoftTextBox}"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,18"/>

                <TextBlock Text="ПАРОЛЬ (минимум 8 символов)" Style="{StaticResource LabelText}"/>
                <PasswordBox Style="{StaticResource SoftPasswordBox}"
                             x:Name="PwdBox"
                             PasswordChanged="PwdBox_PasswordChanged"
                             Margin="0,0,0,18"/>

                <TextBlock Text="ПОДТВЕРЖДЕНИЕ ПАРОЛЯ" Style="{StaticResource LabelText}"/>
                <PasswordBox Style="{StaticResource SoftPasswordBox}"
                             x:Name="ConfirmPwdBox"
                             PasswordChanged="ConfirmPwdBox_PasswordChanged"
                             Margin="0,0,0,18"/>

                <!-- Инфо-блок -->
            


                <Button Content="ЗАРЕГИСТРИРОВАТЬСЯ"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="50" FontSize="15" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="Уже есть аккаунт? "
                               Foreground="#5f7f8f"/>
                    <Button Content="Войти" Command="{Binding BackToLoginCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#4a90a4"
                            Cursor="Hand" FontWeight="SemiBold" Padding="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>