<Window x:Class="HackathonHub.Client.Views.ManageCriteriaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление критериями" Height="650" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#f7fafc"
        ResizeMode="CanResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="24" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="{StaticResource SkyGrad}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="#eef4f8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dde9f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="📋 Критерии оценки"
                   FontSize="24" FontWeight="Bold"
                   Foreground="#1a2b38"
                   Margin="0,0,0,15"/>

        <Border Grid.Row="1" Style="{StaticResource Tile}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CriteriaList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#f7fafc" CornerRadius="12"
                                    Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="#1a2b38"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" Foreground="#7d8f9c"
                                                   TextWrapping="Wrap"
                                                   Margin="0,2,0,4"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="11" Foreground="#7d8f9c">
                                                <Run Text="Макс. балл: "/>
                                                <Run Text="{Binding MaxScore}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="#7d8f9c"
                                                       Margin="14,0,0,0">
                                                <Run Text="Вес: "/>
                                                <Run Text="{Binding Weight}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <Button Grid.Column="1"
                                            Content="🗑 УДАЛИТЬ"
                                            Click="Delete_Click"
                                            Tag="{Binding Id}"
                                            Style="{StaticResource SoftPill}"
                                            Background="#f8d7d7"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="+ ДОБАВИТЬ КРИТЕРИЙ"
                    Click="Add_Click"
                    Style="{StaticResource Pill}"
                    Margin="0,0,10,0"/>
            <Button Content="ЗАКРЫТЬ"
                    Click="Close_Click"
                    Style="{StaticResource SoftPill}"/>
        </StackPanel>
    </Grid>
</Window>