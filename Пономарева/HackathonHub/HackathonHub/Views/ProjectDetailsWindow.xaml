<Window x:Class="HackathonHub.Client.Views.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Проект" Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#f7fafc"
        ResizeMode="CanResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="24" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="#eef4f8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dde9f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Tile}" Margin="20" Padding="30">
            <StackPanel>
                <Border Width="60" Height="60" CornerRadius="18"
                        Background="{StaticResource SkyGrad}"
                        HorizontalAlignment="Left">
                    <TextBlock Text="📦" FontSize="26"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock x:Name="TitleText"
                           FontSize="26" FontWeight="Bold"
                           Foreground="#1a2b38" Margin="0,18,0,6"
                           TextWrapping="Wrap"/>

                <TextBlock x:Name="TeamInfoText"
                           FontSize="13" Foreground="#7d8f9c"
                           Margin="0,0,0,20"
                           TextWrapping="Wrap"/>

                <TextBlock Text="ОПИСАНИЕ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <Border Background="#f7fafc" CornerRadius="12" Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="DescText"
                               FontSize="13" Foreground="#1a2b38"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="ССЫЛКА НА РЕПОЗИТОРИЙ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <Border Background="#f7fafc" CornerRadius="12" Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="RepoText"
                               FontSize="13" Foreground="#5eb3d6"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="ФАЙЛ ПРОЕКТА" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <Border Background="#f7fafc" CornerRadius="12" Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="FilePathText"
                               FontSize="12" Foreground="#1a2b38"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock Text="ПРЕЗЕНТАЦИЯ" FontSize="11" FontWeight="SemiBold"
                           Foreground="#7d8f9c" Margin="0,0,0,6"/>
                <Border Background="#f7fafc" CornerRadius="12" Padding="14"
                        Margin="0,0,0,16">
                    <TextBlock x:Name="PresentationText"
                               FontSize="12" Foreground="#1a2b38"
                               TextWrapping="Wrap"/>
                </Border>

                <TextBlock x:Name="UploadedText"
                           FontSize="11" Foreground="#7d8f9c"
                           Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Button Content="📁 ФАЙЛ ПРОЕКТА"
                            Click="OpenFile_Click"
                            Style="{StaticResource SoftPill}"
                            Margin="0,0,10,0"/>
                    <Button Content="📊 ПРЕЗЕНТАЦИЯ"
                            Click="OpenPresentation_Click"
                            Style="{StaticResource SoftPill}"
                            Margin="0,0,10,0"/>
                    <Button Content="🔗 РЕПОЗИТОРИЙ"
                            Click="OpenRepo_Click"
                            Style="{StaticResource SoftPill}"/>
                </StackPanel>

                <Button Content="ЗАКРЫТЬ"
                        Click="Close_Click"
                        Style="{StaticResource SoftPill}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>