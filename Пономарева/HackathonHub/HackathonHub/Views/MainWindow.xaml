                                        <ComboBoxItem Content="Организатор" Tag="organizer"/>
                                        <ComboBoxItem Content="Жюри" Tag="jury"/>
                                        <ComboBoxItem Content="Админ" Tag="admin"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>
                            <Button Content="✓ СОЗДАТЬ ПОЛЬЗОВАТЕЛЯ"
                                    Command="{Binding CreateUserCommand}"
                                    Style="{StaticResource Pill}"
