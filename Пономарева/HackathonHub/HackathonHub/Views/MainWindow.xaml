                                    Command="{Binding ExportTeamsExcelCommand}"
                                    Style="{StaticResource SoftPill}"/>
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource Tile}" Padding="20" Margin="0,0,0,25">
