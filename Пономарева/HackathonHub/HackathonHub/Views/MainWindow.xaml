                                <DataGridTextColumn Header="ПРОЕКТ" Binding="{Binding ProjectTitle}" Width="*"/>
                                <DataGridTextColumn Header="ОЧКИ" Binding="{Binding TotalScore}" Width="110"/>
                                <DataGridTextColumn Header="СУДЕЙ" Binding="{Binding JuryCount}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
