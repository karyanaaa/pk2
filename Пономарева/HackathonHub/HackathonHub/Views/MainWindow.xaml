                            <TextBlock Text="НАВЫКИ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSkills, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" FontSize="14"
                                     Background="White" BorderBrush="#dde9f0"
                                     BorderThickness="1" Margin="0,0,0,20"
                                     AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                            <Button Content="💾 СОХРАНИТЬ ПРОФИЛЬ"
                                    Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource Pill}"
                                    HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Tile}" Padding="26" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Смена пароля"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="#1a2b38" Margin="0,0,0,20"/>
                            <TextBlock Text="СТАРЫЙ ПАРОЛЬ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding OldPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" FontSize="14"
                                     Background="White" BorderBrush="#dde9f0"
                                     BorderThickness="1" Margin="0,0,0,12"/>
                            <TextBlock Text="НОВЫЙ ПАРОЛЬ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" FontSize="14"
                                     Background="White" BorderBrush="#dde9f0"
                                     BorderThickness="1" Margin="0,0,0,12"/>
                            <TextBlock Text="ПОДТВЕРЖДЕНИЕ" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#7d8f9c" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding NewPasswordConfirm, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,10" FontSize="14"
                                     Background="White" BorderBrush="#dde9f0"
                                     BorderThickness="1" Margin="0,0,0,20"/>
                            <Button Content="🔒 СМЕНИТЬ ПАРОЛЬ"
                                    Command="{Binding ChangePasswordCommand}"
                                    Style="{StaticResource Pill}"
                                    HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Border>

                    <Button Content="⏻ ВЫЙТИ ИЗ АККАУНТА"
                            Command="{Binding LogoutCommand}"
                            Style="{StaticResource SoftPill}"
                            Background="#f8d7d7"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,40"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>