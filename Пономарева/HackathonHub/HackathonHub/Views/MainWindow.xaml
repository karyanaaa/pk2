                                           Foreground="#1a2b38" Margin="0,8,0,0"/>
                                <TextBlock Text="Участников" FontSize="12" Foreground="#7d8f9c"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}"
                                Background="{StaticResource PinkCard}"
                                Padding="24">
