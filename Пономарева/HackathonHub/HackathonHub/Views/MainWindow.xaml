<Window x:Class="HackathonHub.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HackathonHub" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#f7fafc"
        WindowState="Maximized">

    <Window.Resources>
        <SolidColorBrush x:Key="SkyCard" Color="#e3f2fd"/>
        <SolidColorBrush x:Key="MintCard" Color="#e0f7f5"/>
        <SolidColorBrush x:Key="PeachCard" Color="#fef3e2"/>
        <SolidColorBrush x:Key="PinkCard" Color="#fce7ef"/>

        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="MintGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5fd4b8" Offset="0"/>
            <GradientStop Color="#85e0c8" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="28"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="30" ShadowDepth="4" Opacity="0.35"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="{StaticResource SkyGrad}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="#eef4f8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dde9f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TopNav" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#7d8f9c"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="18" Padding="20,10" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#eef4f8"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1a2b38"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Table" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#fafcfd"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#eef4f8"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="46"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ШАПКА ===== -->
        <Border Grid.Row="0" Background="Transparent" Padding="40,24,40,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource SkyGrad}">
                        <TextBlock Text="&lt;/&gt;" FontSize="20" FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="HackathonHub" FontSize="16" FontWeight="Bold"
                                   Foreground="#1a2b38"/>
                        <TextBlock Text="{Binding GreetingText}" FontSize="11"
                                   Foreground="#7d8f9c"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Content="🏠 Хакатоны" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Hackathons"
                                 Style="{StaticResource TopNav}" Margin="3,0"
                                 Visibility="{Binding MenuHackathons}"/>
                    <RadioButton Content="✨ Моё пространство" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="MySpace"
                                 Style="{StaticResource TopNav}" Margin="3,0"
                                 Visibility="{Binding MenuMySpace}"/>
                    <RadioButton Content="📋 Мои хакатоны" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="MyHackathons"
                                 Style="{StaticResource TopNav}" Margin="3,0"
                                 Visibility="{Binding MenuMyHackathons}"/>
                    <RadioButton Content="⭐ Оценка проектов" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Jury"
                                 Style="{StaticResource TopNav}" Margin="3,0"
                                 Visibility="{Binding MenuJury}"/>
                    <RadioButton Content="🏆 Рейтинг" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Ratings"
                                 Style="{StaticResource TopNav}" Margin="3,0"
                                 Visibility="{Binding MenuRatings}"/>
                    <RadioButton Content="🔧 Пользователи" GroupName="Nav"
                                 Command="{Binding NavigateCommand}" CommandParameter="Admin"
                                 Style="{StaticResource TopNav}" Margin="3,0"
                                 Visibility="{Binding MenuAdmin}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Profile"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Padding="0" Margin="0,0,10,0" ToolTip="Профиль">
                        <Grid Width="46" Height="46">
                            <Border CornerRadius="23"
                                    Background="{Binding CurrentRoleColor}"
                                    Visibility="{Binding InitialVisibility}">
                                <TextBlock Text="{Binding CurrentUserInitial}"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border CornerRadius="23" ClipToBounds="True"
                                    Visibility="{Binding AvatarVisibility}">
                                <Image Source="{Binding AvatarSource}" Stretch="UniformToFill"/>
                            </Border>
                        </Grid>
                    </Button>
                    <Button Content="⏻" Command="{Binding LogoutCommand}"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#e8a8c4" FontSize="24" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="40,10,40,40">

            <!-- ============ HACKATHONS ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsHackathonsPage}">
                <StackPanel>
                    <TextBlock Text="Хакатоны"
                               FontSize="30" FontWeight="Bold"
                               Foreground="#1a2b38" Margin="0,0,0,20"/>

                    <Border Style="{StaticResource Tile}" Padding="18" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="12,8" FontSize="13"
                                     Background="White" BorderBrush="#dde9f0"
                                     BorderThickness="1"
                                     ToolTip="Поиск по названию"/>

                            <ComboBox Grid.Column="1"
                                      Width="150" Margin="10,0,0,0"
                                      Padding="10,8" FontSize="13"
                                      SelectedValue="{Binding FilterStatus, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Все" Tag="all"/>
                                <ComboBoxItem Content="Открыт" Tag="open"/>
                                <ComboBoxItem Content="Идёт" Tag="ongoing"/>
                                <ComboBoxItem Content="Закрыт" Tag="closed"/>
                                <ComboBoxItem Content="Завершён" Tag="finished"/>
                            </ComboBox>

                            <ComboBox Grid.Column="2"
                                      Width="170" Margin="10,0,0,0"
                                      Padding="10,8" FontSize="13"
                                      SelectedValue="{Binding FilterSort, Mode=TwoWay}"
                                      SelectedValuePath="Tag">
                                <ComboBoxItem Content="Сначала новые" Tag="date_desc"/>
                                <ComboBoxItem Content="Сначала старые" Tag="date_asc"/>
                                <ComboBoxItem Content="По названию" Tag="title"/>
                                <ComboBoxItem Content="По дедлайну" Tag="deadline"/>
                            </ComboBox>

                            <CheckBox Grid.Column="3"
                                      Content="Только мои"
                                      IsChecked="{Binding OnlyMyParticipating, Mode=TwoWay}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"
                                      FontSize="13"
                                      Foreground="#1a2b38"
                                      Visibility="{Binding MenuMySpace}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Tile}" Padding="18" Margin="0,0,0,20">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📜" FontSize="22" VerticalAlignment="Center"/>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Общие правила хакатона"
                                               FontSize="14" FontWeight="Bold" Foreground="#1a2b38"/>
                                    <TextBlock Text="Прочитайте перед участием"
                                               FontSize="11" Foreground="#7d8f9c"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Content="ПОКАЗАТЬ ПРАВИЛА"
                                    Command="{Binding ShowRulesCommand}"
                                    Style="{StaticResource Pill}"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Hackathons}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Tile}"
                                        Width="360" Margin="0,0,20,20"
                                        Padding="28" Cursor="Hand">
                                    <Border.InputBindings>
                                        <MouseBinding MouseAction="LeftClick"
                                                      Command="{Binding DataContext.ViewHackathonCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}"/>
                                    </Border.InputBindings>
                                    <StackPanel>
                                        <Grid>
                                            <Border Width="50" Height="50" CornerRadius="16"
                                                    Background="{StaticResource SkyGrad}"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="🚀" FontSize="22"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Background="#e0f7f5" CornerRadius="14"
                                                    Padding="12,5"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Status}"
                                                           Foreground="#1a2b38"
                                                           FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="20" FontWeight="Bold"
                                                   Foreground="#1a2b38" Margin="0,18,0,8"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12" Foreground="#7d8f9c"
                                                   TextWrapping="Wrap" MaxHeight="60"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#f7fafc" CornerRadius="16"
                                                Padding="14,10" Margin="0,18,0,0">
                                            <TextBlock Text="{Binding StartDate, StringFormat='📅 dd MMMM yyyy'}"
                                                       Foreground="#1a2b38"
                                                       FontSize="12" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ MY SPACE ============ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsMySpacePage}">
                <StackPanel>
                    <Grid Margin="0,0,0,25">
                        <StackPanel>
                            <TextBlock Text="Моё пространство"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="#1a2b38"/>
                            <TextBlock Text="Управляйте командами, чатами и проектами"
                                       FontSize="13" Foreground="#7d8f9c"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <UniformGrid Columns="4" Margin="0,0,0,25">
                        <Border Style="{StaticResource Tile}"
                                Background="{StaticResource SkyCard}"
                                Padding="20" Margin="0,0,14,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📨" FontSize="24"/>
                                    <TextBlock Text="Заявки" FontSize="12"
                                               Foreground="#7d8f9c"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding PendingRequests.Count}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="#1a2b38" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}"
                                Background="{StaticResource MintCard}"
                                Padding="20" Margin="0,0,14,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💬" FontSize="24"/>
                                    <TextBlock Text="Чаты" FontSize="12"
                                               Foreground="#7d8f9c"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MyChats.Count}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="#1a2b38" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}"
                                Background="{StaticResource PeachCard}"
                                Padding="20" Margin="0,0,14,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📩" FontSize="24"/>
                                    <TextBlock Text="Приглашения" FontSize="12"
                                               Foreground="#7d8f9c"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MyInvitations.Count}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="#1a2b38" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Tile}"
                                Background="{StaticResource PinkCard}"
                                Padding="20">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="24"/>
                                    <TextBlock Text="Команды" FontSize="12"
                                               Foreground="#7d8f9c"
                                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="{Binding MyTeams.Count}"
                                           FontSize="30" FontWeight="Bold"
                                           Foreground="#1a2b38" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📨" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Заявки в мою команду"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#1a2b38"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource Tile}" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding PendingRequests}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#f7fafc" CornerRadius="12"
                                                        Padding="14" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontSize="14" FontWeight="Bold"
                                                                       Foreground="#1a2b38"
                                                                       Text="{Binding UserName}"/>
                                                            <TextBlock FontSize="11" Foreground="#7d8f9c"
                                                                       Text="{Binding UserEmail}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                            <Button Content="✓"
                                                                    Click="AcceptRequest_Click"
                                                                    Tag="{Binding Id}"
                                                                    Style="{StaticResource SoftPill}"
                                                                    Background="#d7f0e0"
                                                                    Padding="10,6" Margin="0,0,6,0"/>
                                                            <Button Content="✗"
                                                                    Click="RejectRequest_Click"
                                                                    Tag="{Binding Id}"
                                                                    Style="{StaticResource SoftPill}"
                                                                    Background="#f8d7d7"
                                                                    Padding="10,6"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Заявок пока нет"
                                               FontSize="13" Foreground="#7d8f9c"
                                               HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding PendingRequests.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="📩" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Приглашения в команды"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#1a2b38"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource Tile}" Padding="16">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding MyInvitations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#f7fafc" CornerRadius="12"
                                                        Padding="14" Margin="0,0,0,10">
                                                    <StackPanel>
                                                        <TextBlock FontSize="14" FontWeight="Bold"
                                                                   Foreground="#1a2b38">
                                                            <Run Text="Команда: "/>
                                                            <Run Text="{Binding TeamName}"/>
                                                        </TextBlock>
                                                        <TextBlock FontSize="11" Foreground="#7d8f9c"
                                                                   Margin="0,2,0,8">
                                                            <Run Text="Хакатон: "/>
                                                            <Run Text="{Binding HackathonTitle}"/>
                                                        </TextBlock>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="✓ ПРИНЯТЬ"
                                                                    Command="{Binding DataContext.AcceptInvitationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SoftPill}"
                                                                    Background="#d7f0e0"
                                                                    Padding="12,6" Margin="0,0,6,0"/>
                                                            <Button Content="✗ ОТКЛОНИТЬ"
                                                                    Command="{Binding DataContext.RejectInvitationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SoftPill}"
                                                                    Background="#f8d7d7"
                                                                    Padding="12,6"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Пока нет приглашений"
                                               FontSize="13" Foreground="#7d8f9c"
                                               HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MyInvitations.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="💬" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Мои чаты"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#1a2b38"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Style="{StaticResource Tile}" Padding="16" Margin="0,0,0,20">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding MyChats}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#f7fafc" CornerRadius="12"
                                                        Padding="14" Margin="0,0,0,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0">
                                                            <TextBlock FontSize="14" FontWeight="Bold"
                                                                       Foreground="#1a2b38"
                                                                       Text="{Binding Title}"/>
                                                            <TextBlock FontSize="11" Foreground="#7d8f9c"
                                                                       Text="{Binding TeamNamesText}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Content="ОТКРЫТЬ"
                                                                Command="{Binding DataContext.OpenChatFromListCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource Pill}"
                                                                Padding="14,6"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Вы ещё не в команде ни на одном хакатоне"
                                               FontSize="13" Foreground="#7d8f9c"
                                               HorizontalAlignment="Center" Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MyChats.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="👥" FontSize="20" VerticalAlignment="Center"/>
                                <TextBlock Text="Моя команда"
                                           FontSize="18" FontWeight="Bold"
                                           Foreground="#1a2b38"
                                           Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
