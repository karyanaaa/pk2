                                           Foreground="#1a2b38" Margin="0,8,0,0"/>
                                <TextBlock Text="Пользователей" FontSize="12" Foreground="#7d8f9c"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile}"
                                Background="{StaticResource MintCard}"
                                Padding="24" Margin="0,0,15,0">
                            <StackPanel>
                                <TextBlock Text="⚖️" FontSize="30"/>
                                <TextBlock Text="{Binding JuryCount}"
                                           FontSize="36" FontWeight="Bold"
                                           Foreground="#1a2b38" Margin="0,8,0,0"/>
                                <TextBlock Text="Жюри" FontSize="12" Foreground="#7d8f9c"/>
