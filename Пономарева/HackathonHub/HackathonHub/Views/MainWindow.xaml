                                <Run Text="{Binding FilteredMyHackathons.Count, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding FilteredMyHackathons}" Margin="0,0,0,25">
