<Window x:Class="HackathonHub.Client.Views.ScoreProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оценка проекта" Height="700" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#f7fafc"
        ResizeMode="CanResize">

    <Window.Resources>
        <LinearGradientBrush x:Key="SkyGrad" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#5eb3d6" Offset="0"/>
            <GradientStop Color="#7fc6e0" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="#ffffff"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#c8dae4" BlurRadius="24" ShadowDepth="3" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="{StaticResource SkyGrad}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPill" TargetType="Button">
            <Setter Property="Foreground" Value="#1a2b38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="30" Background="#eef4f8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#dde9f0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScoreSlider" TargetType="Slider">
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="TickFrequency" Value="1"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="30">

            <Border Style="{StaticResource Tile}" Padding="26" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="{Binding ProjectTitle}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#1a2b38"/>
                    <TextBlock Text="{Binding TeamName}"
                               FontSize="13" Foreground="#7d8f9c"
                               Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ProjectDescription}"
                               FontSize="13" Foreground="#7d8f9c"
                               TextWrapping="Wrap" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBlock Text="ОЦЕНКА ПО КРИТЕРИЯМ"
                       FontSize="12" FontWeight="Bold"
                       Foreground="#7d8f9c" Margin="0,0,0,12"/>

            <ItemsControl ItemsSource="{Binding Criteria}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Tile}"
                                Padding="22" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="#1a2b38"/>
                                <TextBlock Text="{Binding Description}"
                                           FontSize="11" Foreground="#7d8f9c"
                                           Margin="0,2,0,12"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Slider Grid.Column="0"
                                            Style="{StaticResource ScoreSlider}"
                                            Maximum="{Binding MaxScore}"
                                            Value="{Binding Score}"/>

                                    <Border Grid.Column="1"
                                            Background="{StaticResource SkyGrad}"
                                            CornerRadius="12"
                                            Padding="16,6" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding Score}"
                                                   FontSize="16" FontWeight="Bold"
                                                   Foreground="White"
                                                   MinWidth="26" TextAlignment="Center"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Комментарий (необязательно)"
                                           FontSize="10" Foreground="#7d8f9c"
                                           Margin="0,12,0,4"/>
                                <TextBox Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="10,6" FontSize="12"
                                         Background="#f7fafc" BorderBrush="#dde9f0"
                                         BorderThickness="1" TextWrapping="Wrap"
                                         AcceptsReturn="True" Height="50"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="ОТМЕНА"
                        Click="Cancel_Click"
                        Style="{StaticResource SoftPill}"
                        Margin="0,0,10,0"/>
                <Button Content="✓ СОХРАНИТЬ"
                        Click="Save_Click"
                        Style="{StaticResource Pill}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>