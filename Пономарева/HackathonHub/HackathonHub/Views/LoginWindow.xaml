<Window x:Class="HackathonHub.Client.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HackathonHub — Вход" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#e8f4f8"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <SolidColorBrush x:Key="BgLight" Color="#e8f4f8"/>
        <SolidColorBrush x:Key="BgPanel" Color="#d4e9f0"/>
        <SolidColorBrush x:Key="BgCard" Color="#f5fbfd"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#b8d8e4"/>
        <SolidColorBrush x:Key="AccentTeal" Color="#4a90a4"/>
        <SolidColorBrush x:Key="AccentLavender" Color="#a8c8e8"/>
        <SolidColorBrush x:Key="TextDark" Color="#1e3a4c"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5f7f8f"/>
        <SolidColorBrush x:Key="Danger" Color="#e07a7a"/>

        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#6bb6c9" Offset="0"/>
            <GradientStop Color="#a8c8e8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4a90a4" Offset="0"/>
            <GradientStop Color="#6bb6c9" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#f5fbfd"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#8ab4c8" BlurRadius="18" ShadowDepth="3" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5f7f8f"/>
        </Style>
        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#5f7f8f"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4a90a4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SoftPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e3a4c"/>
            <Setter Property="BorderBrush" Value="#b8d8e4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="#4a90a4">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#6bb6c9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- ЛЕВАЯ ЧАСТЬ — градиент -->
        <Border Grid.Column="0" Background="{StaticResource HeaderGradient}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="140" Height="140" CornerRadius="70"
                        Background="White" Opacity="0.95">
                    <TextBlock Text="&lt;/&gt;" FontSize="64" FontWeight="Bold"
                               Foreground="#4a90a4"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="HackathonHub" FontSize="52" FontWeight="Bold"
                           Foreground="White" Margin="0,30,0,10"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Платформа для проведения хакатонов"
                           FontSize="16" Foreground="#e8f4f8"
                           HorizontalAlignment="Center"/>

                <StackPanel Margin="0,50,0,0" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="⚡" FontSize="20"/>
                        <TextBlock Text="Быстрая регистрация команд" FontSize="14"
                                   Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="🎯" FontSize="20"/>
                        <TextBlock Text="Прозрачное судейство" FontSize="14"
                                   Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8">
                        <TextBlock Text="🚀" FontSize="20"/>
                        <TextBlock Text="Автоматический рейтинг" FontSize="14"
                                   Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ПРАВАЯ ЧАСТЬ — форма -->
        <Grid Grid.Column="1">
            <Border Style="{StaticResource Card}"
                    Margin="40" Padding="50,60"
                    VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Добро пожаловать!" Style="{StaticResource TitleText}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Войдите в свой аккаунт" Style="{StaticResource SubtitleText}"
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <TextBlock Text="EMAIL" Style="{StaticResource LabelText}"/>
                    <TextBox Style="{StaticResource SoftTextBox}"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20"/>

                    <TextBlock Text="ПАРОЛЬ" Style="{StaticResource LabelText}"/>
                    <PasswordBox Style="{StaticResource SoftPasswordBox}"
                                 x:Name="PasswordBox"
                                 PasswordChanged="PasswordBox_PasswordChanged"
                                 Margin="0,0,0,15"/>

                    <Button Content="Забыли пароль?"
                            Command="{Binding ForgotPasswordCommand}"
                            HorizontalAlignment="Right"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#4a90a4"
                            Cursor="Hand" FontSize="12"
                            Margin="0,0,0,25"/>

                    <Border Background="#f8d7d7" CornerRadius="10" Padding="14,10"
                            Margin="0,0,0,20"
                            Visibility="{Binding HasErrorVisibility}">
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="#e07a7a"
                                   FontSize="13" TextWrapping="Wrap"/>
                    </Border>

                    <Button Content="ВОЙТИ" Command="{Binding LoginCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" FontSize="16" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Нет аккаунта? " Foreground="#5f7f8f"/>
                        <Button Content="Зарегистрироваться"
                                Command="{Binding OpenRegisterCommand}"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#4a90a4"
                                Cursor="Hand" FontWeight="SemiBold" Padding="0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#cc000000"
                    Visibility="{Binding IsLoadingVisibility}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Загрузка..." Foreground="White" FontSize="20"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>