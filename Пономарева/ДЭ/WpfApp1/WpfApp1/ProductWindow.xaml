<Window x:Class="WpfApp1.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Товар"
        Height="620" Width="900"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Style="{StaticResource PlainButton}"
                        Click="BtnBack_Click"/>

                <TextBlock Grid.Column="2"
                           x:Name="TxtUserInfo"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="#CCCCCC"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Height="280">
                <Image x:Name="ImgProduct" Stretch="Uniform"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="20,0,0,0">
                <TextBlock x:Name="TxtHeader"
                           Style="{StaticResource CardHeader}"
                           FontSize="18"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtCategory"
                           Style="{StaticResource CardText}"
                           Margin="0,8,0,0"/>
                <TextBlock x:Name="TxtSubcategory"
                           Style="{StaticResource CardText}"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtComposition"
                           Style="{StaticResource CardText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>
                <TextBlock x:Name="TxtDescription"
                           Style="{StaticResource CardText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"/>

                <TextBlock x:Name="TxtPrice"
                           Style="{StaticResource CardPrice}"
                           HorizontalAlignment="Left"
                           FontSize="20"
                           Margin="0,16,0,0"/>

                <TextBlock Text="Размерный ряд:"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           Margin="0,16,0,4"/>

                <ItemsControl x:Name="SizesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushSecondary}"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding Size}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Размер"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbSize"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="Количество"
                                   FontFamily="{StaticResource AppFont}"
                                   FontSize="13"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtQuantity" Text="1"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource BrushSecondary}"
                Padding="16,10">
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Добавить в заказ"
                        Style="{StaticResource AccentButton}"
                        Height="38"
                        Click="BtnAddToOrder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>