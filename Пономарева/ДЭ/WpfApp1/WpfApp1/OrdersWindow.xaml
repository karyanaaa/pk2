<Window x:Class="WpfApp1.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Заказы"
        Height="600" Width="1000"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="← Назад"
                        Style="{StaticResource PlainButton}"
                        Click="BtnBack_Click"/>

                <TextBlock Grid.Column="2"
                           x:Name="TxtUserInfo"
                           FontFamily="{StaticResource AppFont}"
                           FontSize="13"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Панель действий -->
        <Border Grid.Row="1"
                Background="White"
                Padding="12,8"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="Удалить"
                        Style="{StaticResource PlainButton}"
                        Click="BtnDeleteOrder_Click"/>
            </StackPanel>
        </Border>
        <DataGrid Grid.Row="2"
                  x:Name="GridOrders"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="32"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="13"
                  Margin="12"
                  MouseDoubleClick="GridOrders_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№" Binding="{Binding OrderId}" Width="60"/>
                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding OrderDate, StringFormat=d}"
                                    Width="140"/>
                <DataGridTextColumn Header="ФИО клиента"
                                    Binding="{Binding CustomerName}"
                                    Width="*"/>
                <DataGridTextColumn Header="Сумма"
                                    Binding="{Binding Total, StringFormat={}{0:N2} ₽}"
                                    Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>