<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Каталог"
        Height="720" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Style="{StaticResource TopBar}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Image Source="/images/Чудо Обувь.png"
                           Height="36" Margin="0,0,10,0"
                           Stretch="Uniform"/>
                    <TextBlock Text="Чудо Обувь"
                               Style="{StaticResource WindowTitle}"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <!-- Кнопки для АВТОРИЗОВАННЫХ -->
                    <Button x:Name="BtnOrders"
                            Content="Заказы"
                            Style="{StaticResource PlainButton}"
                            Margin="0,0,10,0"
                            Visibility="Collapsed"
                            Click="BtnOrders_Click"/>

                    <TextBlock x:Name="TxtUserInfo"
                               Text=""
                               FontFamily="{StaticResource AppFont}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <Button x:Name="BtnLogout"
                            Content="Выход"
                            Style="{StaticResource PlainButton}"
                            Visibility="Collapsed"
                            Click="BtnLogout_Click"/>

                    <!-- Кнопка для НЕАВТОРИЗОВАННЫХ -->
                    <Button x:Name="BtnLogin"
                            Content="Войти"
                            Style="{StaticResource AccentButton}"
                            Click="BtnLogin_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Фильтры (скрыты для неавторизованных) -->
        <Border x:Name="FilterPanel"
                Grid.Row="1"
                Background="White"
                Padding="12,8"
                BorderBrush="#DDDDDD"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="180"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0"
                         x:Name="TxtSearch"
                         Height="32"
                         Margin="0,0,12,0"
                         ToolTip="Поиск по наименованию и описанию"/>

                <ComboBox Grid.Column="1"
                          x:Name="CmbCategory"
                          Margin="0,0,12,0"/>

                <ComboBox Grid.Column="2"
                          x:Name="CmbSort"/>
            </Grid>
        </Border>

        <!-- Каталог -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      Padding="16">
            <ItemsControl x:Name="ProductsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12"
                                Margin="0,0,0,12"
                                Cursor="Hand"
                                MouseLeftButtonUp="ProductCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="120" Height="120"
                                        BorderBrush="#CCCCCC"
                                        BorderThickness="1"
                                        CornerRadius="4">
                                    <Image Source="{Binding ImagePath}"
                                           Stretch="Uniform"
                                           Margin="4"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CardHeader}">
                                        <Run Text="{Binding Manufacturer}"/>
                                        <Run Text=" | "/>
                                        <Run Text="{Binding Name}"/>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="{Binding Category}"
                                               Margin="0,6,0,0"/>
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="{Binding QuantityText}"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Style="{StaticResource CardText}"
                                               Text="{Binding Composition}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource CardPrice}"
                                           Text="{Binding FinalPrice, StringFormat={}{0:N2} ₽}"/>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="{StaticResource BrushLowStock}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>