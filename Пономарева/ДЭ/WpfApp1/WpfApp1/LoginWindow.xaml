<Window x:Class="WpfApp1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чудо Обувь — Вход"
        Height="480" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

       
        <Border Grid.Row="0" Style="{StaticResource TopBar}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Чудо Обувь" Style="{StaticResource WindowTitle}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="320">

            <Image x:Name="ImgLoginBanner"
                   Source="/images/Чудо Обувь.png"
                   Height="120"
                   Margin="0,0,0,24"
                   Stretch="Uniform"/>

            <TextBlock Text="Логин"
                       FontFamily="{StaticResource AppFont}"
                       FontSize="13"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="TxtLogin"
                     Height="32"
                     Margin="0,0,0,16"/>

            <Button x:Name="BtnLogin"
                    Content="Войти"
                    Style="{StaticResource AccentButton}"
                    Height="40"
                    Click="BtnLogin_Click"/>
        </StackPanel>
    </Grid>
</Window>